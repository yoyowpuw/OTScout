# Build output. These are anchored to the repository root on purpose: an
# unanchored "otscout" also matches the cmd/otscout source directory, which would
# quietly leave the main package out of every clone.
/dist/
/bin/
/otscout
/otscout.exe

# Embedded web build, generated by the frontend build step
/internal/server/webdist/
!/internal/server/webdist/.gitkeep

# Frontend
/web/node_modules/
/web/dist/
/web/.vite/
/web/coverage/

# Local working data. Inventories and findings are user data and often contain
# internal network addresses, so they must never be committed by accident.
*.assets.json
*.findings.json
/corpus/
/out/
/audit/

# Go tooling
*.test
*.out
/coverage.txt

# Editors and OS
.DS_Store
Thumbs.db
.idea/
*.swp
