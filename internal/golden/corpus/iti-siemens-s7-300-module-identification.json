    "source": "Siemens SIMATIC S7-300 CPU 315-2 PN/DP",
    "description": "S7-300 CPU reached over ISO-on-TCP by the snap7 client library",
    "provenance": "captured",
    "license": "CC-BY-4.0",
    "references": [
      "https://github.com/ITI/ICS-Security-Tools/blob/master/pcaps/s7/snap7_s300_everything.pcapng",
      "https://github.com/ITI/ICS-Security-Tools"
    ]
  },
